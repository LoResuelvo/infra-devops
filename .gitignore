# Terraform working directories and local state
.terraform/
*.tfstate
*.tfstate.*

# Local variable values (the documented example is versioned)
*.tfvars
*.tfvars.json
!terraform.tfvars.example

# Plans, logs, and crash reports
*.tfplan
/plan.md
*.log
crash.log
crash.*.log

# OpenStack OpenRC credential files
*openrc*
*OpenRC*

# Terraform override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Local environment files
.env
.deployment-secrets/
**/api.env
.venv/
__pycache__/
*.pyc

# Private keys and TLS certificates
*.key
*.pem
*.crt
id_rsa
id_ed25519

# Local Ansible inventories, keys, and retry artifacts
ansible/inventories/*/hosts.yml
ansible/vars/deploy-keys.yml
ansible/vars/deploy-keys-staging.yml
ansible/vars/deploy-keys-production.yml
ansible/collections/
*.retry
